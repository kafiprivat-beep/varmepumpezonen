---
import type { Advertiser } from "../data/advertisers";

interface Props {
  advertiser: Advertiser;
}

const { advertiser } = Astro.props;
const pros = advertiser.pros ?? [];
---

<article class="card advertiser-card">
  <h3>{advertiser.name}</h3>
  {advertiser.description && <p class="desc">{advertiser.description}</p>}
  {
    pros.length > 0 && (
      <ul class="usps">
        {pros.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )
  }
  <a
    class="btn btn-primary"
    href={advertiser.url}
    rel="sponsored nofollow noopener noreferrer"
    target="_blank"
  >
    Besøg {advertiser.name}
  </a>
</article>
