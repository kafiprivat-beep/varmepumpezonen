---
import "../styles/global.css";
import { SITE, NAV } from "../data/site";

interface ArticleMeta {
  datePublished?: string;
  dateModified?: string;
  author?: string;
}
interface Crumb {
  name: string;
  url: string;
}
interface Props {
  /** Sidetitel UDEN brand-suffix; " | Varmepumpezonen" tilføjes automatisk. */
  title: string;
  description?: string;
  /** OG-billede (absolut URL eller sti). Default = site-banner. */
  image?: string;
  /** Sæt for at udsende Article-schema (eller true for at bruge defaults). */
  article?: ArticleMeta | boolean;
  /** Overskriv auto-genererede brødkrummer. */
  breadcrumbs?: Crumb[];
}

const BRAND = SITE.brand;
const DEFAULT_DESC = SITE.description;

const {
  title,
  description = DEFAULT_DESC,
  image,
  article,
  breadcrumbs,
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);

// --- Titel: fjern evt. brand-suffix og standardisér til "… | Varmepumpezonen"
const pageTitle = title
  .replace(/\s*[—–|-]\s*varmepumpezonen(\.dk)?\s*$/i, "")
  .trim();
const fullTitle = /varmepumpezonen/i.test(pageTitle)
  ? pageTitle
  : `${pageTitle} | ${BRAND}`;

// --- Canonical + OG url
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site).href;
// Socialt delebillede: rasterformat (PNG) er påkrævet af Facebook, LinkedIn m.fl.
const ogImage = new URL(image ?? "/og-image.png", site).href;
const isDefaultOg = !image;
const logoUrl = new URL("/favicon.svg", site).href;

// --- Auto-brødkrummer ud fra sti (medmindre eksplicit angivet)
function autoCrumbs(): Crumb[] {
  const segs = pathname.split("/").filter(Boolean);
  const out: Crumb[] = [{ name: "Forside", url: new URL("/", site).href }];
  let acc = "";
  segs.forEach((seg) => {
    acc += `/${seg}`;
    const name = seg === "artikler" ? "Artikler" : pageTitle;
    out.push({ name, url: new URL(`${acc}/`, site).href });
  });
  return out;
}
const crumbs = breadcrumbs ?? autoCrumbs();

// --- Schema: BreadcrumbList (når der er mere end blot Forside)
const breadcrumbSchema =
  crumbs.length > 1
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: crumbs.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: c.url,
        })),
      }
    : null;

// --- Schema: Article (eksplicit prop ELLER auto-detekteret artikelside)
const isArticlePage =
  !!article ||
  (/^\/artikler\/.+/.test(pathname) && pathname !== "/artikler/") ||
  pathname === "/varmepumpe-guide/";
const meta: ArticleMeta =
  article && typeof article === "object" ? article : {};
const datePublished = meta.datePublished ?? "2026-07-11";
const articleSchema = isArticlePage
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: pageTitle,
      description,
      image: ogImage,
      datePublished,
      dateModified: meta.dateModified ?? datePublished,
      author: { "@type": "Organization", name: meta.author ?? BRAND },
      publisher: {
        "@type": "Organization",
        name: BRAND,
        logo: { "@type": "ImageObject", url: logoUrl },
      },
      mainEntityOfPage: canonical,
    }
  : null;

const ogType = isArticlePage ? "article" : "website";

// --- Schema: WebSite/Organization på forsiden
const isHome = pathname === "/";
const websiteSchema = isHome
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: BRAND,
      url: site.href,
      inLanguage: "da-DK",
      description,
      publisher: {
        "@type": "Organization",
        name: BRAND,
        url: site.href,
        logo: { "@type": "ImageObject", url: logoUrl },
      },
    }
  : null;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#138a5e" />

    <!-- Fonts: Manrope (display) + Atkinson Hyperlegible (brødtekst) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content={`${BRAND} – uvildig guide til varmepumper, priser og tilskud`}
    />
    {
      isDefaultOg && (
        <>
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      breadcrumbSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbSchema)}
        />
      )
    }
    {
      articleSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(articleSchema)}
        />
      )
    }
    {
      websiteSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(websiteSchema)}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo" aria-label="Varmepumpezonen — forside">
          <span class="logo__mark" aria-hidden="true">
            <svg viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="28" height="28" rx="8" fill="#138a5e"></rect>
              <g stroke="#ffffff" stroke-width="2" stroke-linecap="round">
                <path d="M10 20.5c-2.4-2.2-2.4-3.8 0-6s2.4-3.8 0-6"></path>
                <path d="M18 20.5c-2.4-2.2-2.4-3.8 0-6s2.4-3.8 0-6"></path>
              </g>
            </svg>
          </span>
          <span class="logo__word">Varmepumpezonen</span>
        </a>
        <nav class="main-nav" aria-label="Hovedmenu">
          {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div>
          <h4>{SITE.brand}.dk</h4>
          <p style="max-width: 340px; margin:0;">
            Uvildig guide til varmepumper for danske boligejere — typer, priser,
            tilskud og besparelser samlet ét sted, så du kan vælge rigtigt.
          </p>
        </div>
        <div>
          <h4>Populære emner</h4>
          <ul>
            <li><a href="/varmepumpe-guide/">Varmepumpe-guide 2026</a></li>
            <li>
              <a href="/artikler/varmepumpe-pris-montering-2026/">Priser inkl. montering</a>
            </li>
            <li>
              <a href="/artikler/varmepumpe-tilskud-fradrag-2026/">Tilskud & fradrag 2026</a>
            </li>
            <li>
              <a href="/artikler/bedste-varmepumpe-maerker/">Bedste mærker</a>
            </li>
          </ul>
        </div>
        <div>
          <h4>Mere</h4>
          <ul>
            <li><a href="/artikler/">Alle artikler</a></li>
            <li>
              <a href="/artikler/faa-3-tilbud-tjekliste/">Få 3 gratis tilbud</a>
            </li>
          </ul>
        </div>
        <p class="copyright">
          © {year} {SITE.domain} · Vi formidler kontakt til varmepumpe-installatører
          og kan modtage et honorar, når du indhenter tilbud via siden — det
          koster dig ikke ekstra. Alle priser og tilskud er vejledende og bør
          altid tjekkes mod et konkret tilbud.
        </p>
      </div>
    </footer>
  </body>
</html>
