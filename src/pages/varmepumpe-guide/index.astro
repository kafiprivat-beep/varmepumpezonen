---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleView from "../../components/ArticleView.astro";
import { getPillar } from "../../data/articles";

const article = getPillar();
---

<BaseLayout
  title={article.title}
  description={article.description}
  article={{ datePublished: article.updated, dateModified: article.updated }}
>
  <ArticleView article={article} />
</BaseLayout>
