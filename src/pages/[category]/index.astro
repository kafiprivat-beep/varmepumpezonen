---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdvertiserCard from "../../components/AdvertiserCard.astro";
import {
  categories,
  getAdvertisersByCategory,
  type Category,
} from "../../data/advertisers";
import { getCategoryContent } from "../../data/categoryContent";
import { productsForCategory, type ShopProduct } from "../../lib/products";

export async function getStaticPaths() {
  // Hent produkter pr. kategori på build-tid. productsForCategory cacher feeds
  // på tværs af kald, så de 25 feeds kun fetches én gang.
  return Promise.all(
    categories.map(async (category) => ({
      params: { category: category.slug },
      props: {
        category,
        products: await productsForCategory(category.slug, 60),
      },
    })),
  );
}

interface Props {
  category: Category;
  products: ShopProduct[];
}

const { category, products } = Astro.props;
const ads = getAdvertisersByCategory(category.slug);
const content = getCategoryContent(category.slug);

// Unik meta-titel + beskrivelse pr. kategori (falder tilbage til auto-genereret).
const navnLc = category.name.toLowerCase();
const seoTitle =
  content?.metaTitle ?? `${category.name} – test, guide og bedste priser`;
let seoDesc =
  content?.metaDescription ??
  `${category.name}: ${category.description} Sammenlign ${products.length} produkter og find de bedste priser på ${navnLc} hos danske forhandlere.`;
if (seoDesc.length > 160) seoDesc = seoDesc.slice(0, 157).trimEnd() + "…";
const ogImg = products.find((p) => p.billedUrl)?.billedUrl;

// FAQPage-schema (JSON-LD) af kategoriens FAQ.
const faqSchema =
  content && content.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: content.faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;

const formatPrice = (pris: string): string => {
  const t = (pris ?? "").trim();
  if (!t) return "";
  // Feedet bruger punktum som decimaltegn (fx "1499.00").
  const num = Number(t.replace(/[^\d.]/g, ""));
  if (!Number.isFinite(num)) return /kr|dkk|,-/i.test(t) ? t : `${t} kr.`;
  const hasDecimals = Math.round(num * 100) % 100 !== 0;
  const formatted = new Intl.NumberFormat("da-DK", {
    minimumFractionDigits: hasDecimals ? 2 : 0,
    maximumFractionDigits: 2,
  }).format(num);
  return `${formatted} kr.`;
};
---

<BaseLayout title={seoTitle} description={seoDesc} image={ogImg}>
  {
    faqSchema && (
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(faqSchema)}
      />
    )
  }
  <section class="section">
    <div class="container">
      <p class="breadcrumb">
        <a href="/">Forside</a> ›
        <span>{category.name}</span>
      </p>

      <div
        class="cat-hero"
        style={`background-image:url('/images/categories/${category.slug}.webp')`}
      >
        <div class="cat-hero-inner">
          <h1>{category.name}</h1>
          <p>{category.description}</p>
        </div>
      </div>

      <div class="disclosure">
        Produkterne herunder hentes fra vores partnere via Partner-ads og er
        sorteret efter laveste pris. Links er affiliate-links — køber du via
        dem, kan vi modtage en kommission uden ekstra omkostning for dig.
      </div>

      {
        products.length > 0 ? (
          <>
            <h2 class="section-title" style="font-size:1.4rem;">
              {products.length}{" "}
              {products.length === 1 ? "produkt" : "produkter"} fundet
            </h2>
            <div class="product-grid">
              {products.map((p) => (
                <article class="product-card">
                  <div class="product-img">
                    {p.billedUrl ? (
                      <img
                        src={p.billedUrl}
                        alt={p.navn}
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        onerror="this.style.display='none';this.parentElement.classList.add('img-failed')"
                      />
                    ) : (
                      <span class="img-fallback">Billede følger</span>
                    )}
                  </div>
                  <div class="product-body">
                    <h3>{p.navn}</h3>
                    {p.pris && <p class="price">{formatPrice(p.pris)}</p>}
                    <p class="shop">hos {p.advertiserName}</p>
                    <a
                      class="btn btn-primary buy"
                      href={p.vareUrl}
                      target="_blank"
                      rel="sponsored nofollow noopener noreferrer"
                    >
                      Se produkt →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="placeholder">
            <h2>Produkter på vej</h2>
            <p>
              Vi henter {category.name.toLowerCase()} fra vores partnere lige
              nu. Indtil da kan du udforske udvalget direkte hos butikkerne
              nedenfor.
            </p>
          </div>
        )
      }

      {
        content && (
          <section class="buying-guide">
            <h2>{content.guideHeading}</h2>
            {content.guideParagraphs.map((p) => (
              <p>{p}</p>
            ))}
          </section>
        )
      }

      <h2 class="section-title" style="font-size:1.4rem; margin-top:3rem;">
        Køb {category.name.toLowerCase()} hos
      </h2>
      <div class="grid grid-cards">
        {ads.map((a) => <AdvertiserCard advertiser={a} />)}
      </div>

      {
        content && content.faq.length > 0 && (
          <section class="faq">
            <h2 class="section-title" style="font-size:1.4rem;">
              Ofte stillede spørgsmål om {navnLc}
            </h2>
            <div class="faq-list">
              {content.faq.map((f) => (
                <details class="faq-item">
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1rem;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition:
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }
  .product-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
  }
  .product-img {
    height: 200px;
    background: var(--color-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .product-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* Placeholder for produkter helt uden billede i feedet. */
  .img-fallback {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-align: center;
  }
  /* Vises hvis et feed-billede ikke kan loade (død URL) – sat af onerror.
     Samme grå boks med "Intet billede" som når billedet helt mangler. */
  .product-img.img-failed {
    background: var(--color-border);
  }
  .product-img.img-failed::after {
    content: "Billede følger";
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-muted);
    text-align: center;
  }
  .product-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.2rem;
    flex: 1 1 auto;
  }
  .product-body h3 {
    font-size: 1rem;
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .price {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
  }
  .shop {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .buy {
    margin-top: auto;
    align-self: flex-start;
  }
  .placeholder {
    background: var(--color-secondary);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
    margin-bottom: 1rem;
  }

  /* ── Købsguide ── */
  .buying-guide {
    max-width: 760px;
    margin: 3rem 0 1rem;
    padding: 2rem 2.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .buying-guide h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 0 0 1rem;
  }
  .buying-guide p {
    margin: 0 0 1rem;
    color: var(--color-text);
  }
  .buying-guide p:last-child {
    margin-bottom: 0;
  }

  /* ── FAQ ── */
  .faq {
    margin-top: 3.5rem;
    max-width: 760px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 1.15rem;
    box-shadow: var(--shadow);
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    padding: 0.85rem 0;
    list-style: none;
    position: relative;
    padding-right: 2rem;
    color: var(--color-primary);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: "+";
    position: absolute;
    right: 0.2rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--color-accent);
    line-height: 1;
  }
  .faq-item[open] summary::after {
    content: "–";
  }
  .faq-item p {
    margin: 0 0 0.95rem;
    color: var(--color-text-muted);
  }
</style>
