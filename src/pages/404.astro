---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPillar, getSupportArticles, articleUrl } from "../data/articles";

const pillar = getPillar();
const supports = getSupportArticles().slice(0, 6);
---

<BaseLayout
  title="Siden blev ikke fundet (404)"
  description="Vi kunne ikke finde den side, du ledte efter. Gå tilbage til forsiden eller find en af vores guides om varmepumper, priser og tilskud."
>
  <meta slot="head" name="robots" content="noindex, follow" />
  <section class="section">
    <div class="container notfound">
      <span class="eyebrow">Fejl 404</span>
      <h1>Siden blev ikke fundet</h1>
      <p class="notfound__lead">
        Siden er måske flyttet eller findes ikke længere. Kom videre herfra:
      </p>
      <p class="notfound__cta">
        <a href="/" class="btn btn-accent btn-lg">Gå til forsiden</a>
        <a href={articleUrl(pillar)} class="btn btn-outline btn-lg">
          Læs varmepumpe-guiden
        </a>
      </p>

      <h2>Populære guides</h2>
      <ul class="notfound__cats">
        {supports.map((s) => (
          <li><a href={articleUrl(s)}>{s.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 760px;
    padding-top: 1rem;
    padding-bottom: 2rem;
  }
  .notfound__lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0.5rem 0 1.75rem;
  }
  .notfound__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }
  .notfound h2 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
  }
  .notfound__cats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .notfound__cats a {
    font-weight: 600;
    color: var(--color-accent);
  }
</style>
