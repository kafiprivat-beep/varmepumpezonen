---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Photo from "../../components/Photo.astro";
import LeadCta from "../../components/LeadCta.astro";
import { lucide } from "../../lib/icons";
import { getPillar, getSupportArticles, articleUrl } from "../../data/articles";

const pillar = getPillar();
const supports = [...getSupportArticles()].sort((a, b) =>
  a.title.localeCompare(b.title, "da"),
);
---

<BaseLayout
  title="Varmepumpe-artikler: guides om pris, tilskud og typer"
  description="Alle vores guides om varmepumper: priser inkl. montering, tilskud 2026, luft-til-vand vs. luft-til-luft, dimensionering, støj, drift og bedste mærker."
>
  <section class="section">
    <div class="container">
      <p class="breadcrumb"><a href="/">Forside</a> › <span>Artikler</span></p>
      <h1 class="section-title">Guides om varmepumper</h1>
      <p class="section-subtitle">
        Bliv klogere på typer, priser, tilskud og drift — før du henter tilbud.
      </p>

      <a href={articleUrl(pillar)} class="pillar-banner">
        <div class="pillar-banner__media">
          <Photo file={pillar.hero.file} alt={pillar.hero.alt} width={900} height={600} />
        </div>
        <div class="pillar-banner__body">
          <span class="chip">Start her · Stor guide</span>
          <h2>{pillar.title}</h2>
          <p>{pillar.excerpt}</p>
          <span class="cat-link">
            Læs guiden
            <Fragment set:html={lucide("arrow-right", 16)} />
          </span>
        </div>
      </a>

      <div class="grid grid-cards" style="margin-top:2.5rem;">
        {
          supports.map((art) => (
            <a href={articleUrl(art)} class="card article-card">
              <span class="chip">{art.category}</span>
              <h3>{art.title}</h3>
              <p>{art.excerpt}</p>
              <span class="cat-link">
                Læs mere
                <Fragment set:html={lucide("arrow-right", 16)} />
              </span>
            </a>
          ))
        }
      </div>

      <div style="margin-top:2.5rem;">
        <LeadCta slotKey="artikler-index" />
      </div>
    </div>
  </section>
</BaseLayout>
