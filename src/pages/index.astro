---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import LeadCta from "../components/LeadCta.astro";
import { lucide } from "../lib/icons";
import { getPillar, getSupportArticles, articleUrl } from "../data/articles";

const pillar = getPillar();
const supports = getSupportArticles();

// Fremhævede guides på forsiden.
const featuredSlugs = [
  "varmepumpe-pris-montering-2026",
  "varmepumpe-tilskud-fradrag-2026",
  "luft-til-luft-vs-luft-til-vand",
];
const featuredGuides = supports.filter((s) => featuredSlugs.includes(s.slug));

const trustBadges = [
  { icon: "shield-check", label: "Uvildig, uafhængig rådgivning" },
  { icon: "piggy-bank", label: "Spar op til 50 % på varmen" },
  { icon: "file-check", label: "27.000 kr. i tilskud i 2026" },
  { icon: "leaf", label: "Grøn opvarmning uden fossilt brændsel" },
];

const types = [
  {
    icon: "wind",
    name: "Luft-til-luft",
    price: "12.000–25.000 kr.",
    text: "Billig og hurtig at installere. Varmer luften i rummet — ideel til elvarme, supplement og sommerhus.",
    href: "/artikler/luft-til-luft-vs-luft-til-vand/",
  },
  {
    icon: "home",
    name: "Luft-til-vand",
    price: "90.000–150.000 kr.",
    text: "Danmarks mest solgte. Dækker radiatorer, gulvvarme og varmt vand — det oplagte skift fra olie og gas.",
    href: "/artikler/luft-til-luft-vs-luft-til-vand/",
  },
  {
    icon: "thermometer",
    name: "Jordvarme",
    price: "120.000–180.000 kr.",
    text: "Højest effektivitet og laveste driftsudgift. Kræver haveareal til jordslanger og en større investering.",
    href: "/varmepumpe-guide/#jordvarme",
  },
];

const stats = [
  { value: "40–60 %", label: "typisk lavere varmeregning" },
  { value: "27.000 kr.", label: "tilskud fra varmepumpepuljen 2026" },
  { value: "5–10 år", label: "typisk tilbagebetalingstid" },
  { value: "15–20 år", label: "forventet levetid" },
];

const homeFaq = [
  {
    q: "Hvad koster en varmepumpe i 2026?",
    a: "En luft-til-luft varmepumpe koster typisk 12.000–25.000 kr. inkl. montering, en luft-til-vand varmepumpe 90.000–150.000 kr. og jordvarme 120.000–180.000 kr. Tilskud og fradrag kan trække prisen markant ned.",
  },
  {
    q: "Hvor meget kan jeg spare?",
    a: "De fleste sparer 40–60 % på varmeregningen. Skifter du fra olie eller elvarme, kan besparelsen nå 15.000–25.000 kr. om året.",
  },
  {
    q: "Hvor meget er tilskuddet i 2026?",
    a: "Varmepumpepuljen giver i 2026 et fast tilskud på 27.000 kr. til at udskifte olie- eller gasfyr med en luft-til-vand varmepumpe eller jordvarme. Derudover kan håndværkerfradraget bruges på op til 9.000 kr. pr. voksen.",
  },
  {
    q: "Koster det noget at få 3 tilbud?",
    a: "Nej. At indhente 3 tilbud via os er gratis og uforpligtende. Du bestemmer selv, om du vil gå videre med et af dem.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Varmepumpe 2026: pris, tilskud og de bedste løsninger"
  description="Uvildig guide til varmepumper: priser inkl. montering, 27.000 kr. i tilskud 2026, besparelser vs. olie og gas — og få 3 gratis, uforpligtende tilbud."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
  />

  <!-- Trust-bar -->
  <div class="trust-bar">
    <div class="container">
      {
        trustBadges.map((b) => (
          <span class="trust-bar__item">
            <Fragment set:html={lucide(b.icon, 18)} />
            {b.label}
          </span>
        ))
      }
    </div>
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <span class="eyebrow">Din uvildige varmepumpe-guide</span>
        <h1>Skift til varmepumpe — og halvér varmeregningen</h1>
        <p class="hero__lead">
          Få styr på typer, priser og tilskud i 2026 — og modtag 3 gratis,
          uforpligtende tilbud fra lokale installatører. Vi hjælper dig med at
          vælge den rigtige løsning til dit hus.
        </p>
        <div class="hero__cta">
          <a href="#faa-tilbud" class="btn btn-accent btn-lg" data-affiliate-link="hero">
            Få 3 gratis tilbud
            <Fragment set:html={lucide("arrow-right", 20)} />
          </a>
          <a href="/varmepumpe-guide/" class="btn btn-outline btn-lg">
            Læs den store guide
          </a>
        </div>
      </div>
      <div class="hero__media">
        <Photo
          file="Heat Pump.jpg"
          alt="Udendørs varmepumpe monteret ved facaden på et dansk parcelhus"
          width={900}
          height={720}
          loading="eager"
          class="hero__img"
        />
        <div class="hero__badge">
          <Fragment set:html={lucide("piggy-bank", 26)} />
          <div>
            <strong>27.000 kr. i tilskud</strong>
            <span>via varmepumpepuljen 2026</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Typer -->
  <section class="section" id="typer">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Hvilken varmepumpe passer til dit hus?</h2>
        <p class="section-subtitle">
          Tre hovedtyper dækker de fleste danske boliger. Her er forskellen på
          pris, opvarmning og hvad de egner sig til.
        </p>
      </div>
      <div class="grid grid-types">
        {
          types.map((t) => (
            <a href={t.href} class="card type-card">
              <span class="type-card__icon">
                <Fragment set:html={lucide(t.icon, 26)} />
              </span>
              <h3>{t.name}</h3>
              <p class="type-card__price">{t.price}<span>inkl. montering</span></p>
              <p class="type-card__text">{t.text}</p>
              <span class="cat-link">
                Læs mere
                <Fragment set:html={lucide("arrow-right", 16)} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Lead-CTA -->
  <section class="section-tight" id="faa-tilbud">
    <div class="container">
      <LeadCta slotKey="home-primary" />
    </div>
  </section>

  <!-- Besparelse / tal -->
  <section class="section section-secondary">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Regnestykket taler for sig selv</h2>
        <p class="section-subtitle">
          En varmepumpe er både en økonomisk og en grøn investering. Sådan ser
          tallene typisk ud for et dansk parcelhus i 2026.
        </p>
      </div>
      <div class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <div class="stat__value">{s.value}</div>
              <p class="stat__label">{s.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Populære guides -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Bliv klogere før du vælger</h2>
        <p class="section-subtitle">
          Start med den store guide — eller dyk ned i de mest læste emner.
        </p>
      </div>

      <a href={articleUrl(pillar)} class="pillar-banner">
        <div class="pillar-banner__media">
          <Photo file={pillar.hero.file} alt={pillar.hero.alt} width={900} height={600} />
        </div>
        <div class="pillar-banner__body">
          <span class="chip">Start her · Stor guide</span>
          <h2>{pillar.title}</h2>
          <p>{pillar.excerpt}</p>
          <span class="cat-link">
            Læs guiden
            <Fragment set:html={lucide("arrow-right", 16)} />
          </span>
        </div>
      </a>

      <div class="grid grid-cards" style="margin-top:2.5rem;">
        {
          featuredGuides.map((art) => (
            <a href={articleUrl(art)} class="card article-card">
              <span class="chip">{art.category}</span>
              <h3>{art.title}</h3>
              <p>{art.excerpt}</p>
              <span class="cat-link">
                Læs mere
                <Fragment set:html={lucide("arrow-right", 16)} />
              </span>
            </a>
          ))
        }
      </div>
      <p style="margin-top:1.75rem;">
        <a href="/artikler/" class="btn btn-outline">
          Se alle artikler
          <Fragment set:html={lucide("arrow-right", 18)} />
        </a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-secondary">
    <div class="container">
      <div class="section-head">
        <h2 class="section-title">Ofte stillede spørgsmål</h2>
        <p class="section-subtitle">Det, de fleste spørger om, før de skifter.</p>
      </div>
      <div class="faq-list">
        {
          homeFaq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
